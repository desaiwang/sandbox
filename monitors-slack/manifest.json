{
  "display_information": {
    "name": "Monitor Proto",
    "description": "Prototyping harness for monitor rollup messages",
    "background_color": "#632ca6"
  },
  "features": {
    "bot_user": {
      "display_name": "Datadog",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public",
        "chat:write.customize"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
